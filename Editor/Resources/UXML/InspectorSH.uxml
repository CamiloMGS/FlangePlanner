<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="propertiesContainer" style="flex-grow: 1;">
        <ui:VisualElement name="InstructionsContainer">
            <uie:PropertyField binding-path="RawInstructions" label="Raw Instructions" name="Instructions" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="actionsContainer" style="flex-grow: 1;">
        <ui:Button text="Do Something" name="DoSomething" />
    </ui:VisualElement>
</ui:UXML>
